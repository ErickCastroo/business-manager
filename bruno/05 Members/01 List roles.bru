meta {
  name: List roles
  type: http
  seq: 1
  tags: [
    members
  ]
}

get {
  url: {{baseUrl}}/api/v1/roles
  body: none
  auth: bearer
}

headers {
  X-Business-Id: {{demoBusinessId}}
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.getStatus() === 200) {
    const cashier = res.getBody().data.find((role) => role.code === "CASHIER");
    bru.setVar("inviteRoleId", cashier?.id ?? "");
  }
}

tests {
  test("devuelve los roles activos con permisos", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.some((role) => role.code === "OWNER")).to.equal(true);
    expect(res.getBody().data.every((role) => Array.isArray(role.permissionCodes))).to.equal(true);
  });
}
