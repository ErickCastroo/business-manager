meta {
  name: Refresh
  type: http
  seq: 3
  tags: [
    auth
    smoke
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: none
  auth: none
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("accessToken", res.getBody().data.token.accessToken);
  }
}

tests {
  test("rotates the refresh session", function () {
    const body = res.getBody();

    expect(res.getStatus()).to.equal(200);
    expect(body.data.token.accessToken).to.be.a("string").and.not.be.empty;
    expect(body.data.token.tokenType).to.equal("Bearer");
    expect(body.meta.requestId).to.be.a("string").and.not.be.empty;
    expect(res.getHeader("set-cookie")).to.exist;
  });
}

docs {
  Envía la cookie HttpOnly del login, la rota y reemplaza la variable accessToken.
}
