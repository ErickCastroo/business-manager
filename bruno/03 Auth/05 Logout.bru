meta {
  name: Logout
  type: http
  seq: 5
  tags: [
    auth
    smoke
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/logout
  body: none
  auth: none
}

tests {
  test("revokes the refresh session", function () {
    const body = res.getBody();

    expect(res.getStatus()).to.equal(200);
    expect(body.data.loggedOut).to.equal(true);
    expect(body.meta.requestId).to.be.a("string").and.not.be.empty;
    expect(res.getHeader("set-cookie")).to.exist;
  });
}

docs {
  Revoca el refresh token actual y solicita eliminar la cookie del cliente.
}
