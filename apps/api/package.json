{
  "name": "@business-manager/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @business-manager/contracts && npm run prisma:generate",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build -w @business-manager/contracts && npm run prisma:generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "pretypecheck": "npm run build -w @business-manager/contracts && npm run prisma:generate",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "npm run build -w @business-manager/contracts && npm run prisma:generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "prisma:validate": "prisma validate --config prisma7.config.ts",
    "prisma:format": "prisma format --config prisma7.config.ts",
    "prisma:migrate": "prisma migrate dev --config prisma7.config.ts",
    "prisma:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "prisma:seed": "prisma db seed --config prisma7.config.ts"
  },
  "dependencies": {
    "@business-manager/contracts": "0.0.0",
    "@prisma/adapter-mssql": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "mssql": "^12.7.14",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
